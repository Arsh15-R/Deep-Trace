# DeepTrace Environment Variables
# Copy to .env and populate credentials

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Pinata IPFS Vault Credentials (https://app.pinata.cloud/developers/api-keys)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_key_here
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# On-Field Telegram Bot Credentials (via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
DEEPTRACE_API_URL=http://localhost:8000

# Legal Compliance & Digital Signing
OFFICER_DEFAULT_NAME=Inspector R. Sharma
OFFICER_DEFAULT_BADGE=CID-DEL-8941
DEPARTMENT_NAME=Cyber Crime & Digital Forensics Division
STATUTORY_ACT=BNSS 2023 Section 63
